# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# Hanya dipakai di server (kelola pengguna) & skrip seed. JANGAN diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role

# URL publik aplikasi (dipakai untuk isi QR code). Contoh: https://cek-hidran.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Opsional: uji integrasi RLS (npm run test:rls) ----
