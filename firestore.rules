rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (Fungsi Bantuan Keamanan)
    // ==========================================

    // Cek apakah pengguna sudah login ke sistem
    function isAuthenticated() {
      return request.auth != null;
    }

    // Ambil data profil pengguna yang sedang login
    function currentUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Cek apakah pengguna memiliki Role Admin Sistem aktif
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        currentUserProfile().get('role', '') == 'admin_sistem' && 
        currentUserProfile().get('active', false) == true;
    }

    // Cek apakah pengguna memiliki Role Supervisor K3 atau Admin aktif
    function isSupervisorOrAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        (currentUserProfile().get('role', '') == 'admin_sistem' || currentUserProfile().get('role', '') == 'supervisor_k3') && 
        currentUserProfile().get('active', false) == true;
    }

    // ==========================================
    // KOLEKSI: PROFILES (Data Pengguna & Role)
    // ==========================================
    match /profiles/{userId} {
      // Siapapun yang sudah login dapat membaca daftar profil (untuk nama petugas & verifikasi akses)
      allow read: if isAuthenticated();

      // Hanya Admin yang dapat membuat profil baru atau mengubah peran (role) pengguna lain
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Admin bisa update semua field; User sendiri hanya bisa ubah nama (TIDAK BISA ubah role sendiri)
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active'])
      );

      // Hanya Admin yang bisa menghapus akun pengguna
      allow delete: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: INSPECTIONS (Data Hasil Pemeriksaan)
    // ==========================================
    match /inspections/{inspectionId} {
      // Semua pengguna yang login dapat membaca hasil inspeksi untuk dashboard/laporan
      allow read: if isAuthenticated();

      // Petugas, Supervisor, dan Admin yang aktif dapat mengirimkan hasil inspeksi
      allow create: if isAuthenticated() && currentUserProfile().active == true;

      // Update hasil inspeksi diperbolehkan untuk Admin & Supervisor
      allow update: if isSupervisorOrAdmin();

      // HANYA Admin yang diizinkan menghapus data inspeksi (Fitur Hapus Data di Pengaturan)
      allow delete: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: FINDINGS (Temuan Kerusakan K3)
    // ==========================================
    match /findings/{findingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && currentUserProfile().active == true;
      allow update: if isSupervisorOrAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: HYDRANTS (Master Titik Hydrant)
    // ==========================================
    match /hydrants/{hydrantId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: WAREHOUSES (Master Gudang WH2, WH3, WH4)
    // ==========================================
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: CHECKLIST_ITEMS (Master Komponen Checksheet)
    // ==========================================
    match /checklist_items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: APP_SETTINGS (Pengaturan Frekuensi & Sistem)
    // ==========================================
    match /app_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // KOLEKSI: REINSPECTION_REQUESTS (Permintaan Re-inspeksi)
    // ==========================================
    match /reinspection_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create, update: if isSupervisorOrAdmin() || (isAuthenticated() && currentUserProfile().active == true);
      allow delete: if isAdmin();
    }
  }
}
